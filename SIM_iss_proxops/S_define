class ChaserSimObject : public Trick::SimObject {
public:
    //chaser truth state
    jeod::DynBody dyn_body;  
    // chaser-relative-to-target, JEOD-computed
    // similar to models/dynamics/derived_state/verif/SIM_LvlhRelative/S_define:167
    jeod::LvlhRelativeDerivedState lvlh_rel_state;
    // lives on chaser, not gnc object
    jeod::Force cmd_force_effector;   

    // added after trick build
    jeod::DynBodyInitTransState trans_init;
    jeod::DynBodyInitLvlhRotState lvlh_init;
    jeod::MassBodyInit mass_init;

    ChaserSimObject() {
        P_ENV("initialization") dyn_body.initialize_model(dynamics.dyn_manager);
        P_DYN("initialization") lvlh_rel_state.initialize(dyn_body, dynamics.dyn_manager);
        (1.0, "environment") lvlh_rel_state.update();
        
        //(1.0, "scheduled") std::memcpy(chaser.cmd_force_effector.force,cmd_force, sizeof(cmd_force));
    }
};
ChaserSimObject chaser;

// register for collection
vcollect chaser.dyn_body.collect.collect_effector_forc jeod::CollectForce::create{chaser.cmd_force_effector};

class GncSimObject : public Trick::SimObject {
public:
    Navigation navigation;
    Guidance guidance;
    Control control;
    double meas_rel_pos[3];   /* m Measured relative position */
    double meas_rel_vel[3];   /* m/s Measured relative velocity */
    double setpoint_pos[3];   /* m Setpoint position */
    double setpoint_vel[3];   /* m/s Setpoint velocity */
    double cmd_force[3];      /* N Commanded force */


    GncSimObject() {
    ("initialization") navigation.initialize();
    ("initialization") control.initialize();
    // p.s. guidance doesn't need its own initialize() bc its hold points/corridor
    // params/tolerances are set directly via input.py
    (1.0, "scheduled") navigation.update(chaser.lvlh_rel_state.rel_state.trans.position, 
    chaser.lvlh_rel_state.rel_state.trans.velocity, meas_rel_pos, meas_rel_vel);
    (1.0, "scheduled") guidance.update(exec_get_sim_time(), meas_rel_pos, meas_rel_vel);
    (1.0, "scheduled") guidance.get_setpoint(setpoint_pos, setpoint_vel);
    (1.0, "scheduled") control.update(meas_rel_pos, meas_rel_vel, 
        setpoint_pos, setpoint_vel, cmd_force);

    // moved from ChaserSim to here bc otherwise this copy job would run before
    // control.update() computes this cycle's cmd_force, copying stale value
    (1.0, "scheduled") std::memcpy(chaser.cmd_force_effector.force, 
            cmd_force, sizeof(cmd_force));

    }
};
GncSimObject gnc;

