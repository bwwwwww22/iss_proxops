class TargetSimObject : public Trick::SimObject {
public:
    jeod::DynBody dyn_body;
    jeod::LvlhFrame lvlh_frame;

    // added after trick build
    jeod::DynBodyInitTransState trans_init;
    jeod::DynBodyInitLvlhRotState lvlh_init;
    jeod::MassBodyInit mass_init;

    TargetSimObject() {
        // ("initialization") dyn_body.initialize_model();  // failed to compile
        P_ENV("initialization") dyn_body.initialize_model(dynamics.dyn_manager);
        P_DYN("initialization") lvlh_frame.initialize(dynamics.dyn_manager);
        ("initialization") lvlh_frame.update();
        (1.0, "environment") lvlh_frame.update();
    }
};
